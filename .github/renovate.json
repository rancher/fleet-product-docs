{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rancher/renovate-config//default#release"
  ],
  "baseBranchPatterns": [
    "main",
    "product-docs"
  ],
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* * * * 2"
    ]
  },
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all @antora/* npm packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@antora/*"
      ],
      "groupName": "Antora",
      "commitMessageExtra": "{{{upgrades.0.depName}}}"
    },
    {
      "description": "Activate automerge for eligible updates",
      "matchBaseBranches": [
        "main",
        "product-docs"
      ],
      "extends": [
        "github>rancher/renovate-config//automerge#release"
      ]
    }
  ]
}

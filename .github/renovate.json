{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rancher/renovate-config//default#release"
  ],
  "baseBranchPatterns": [
    "main",
    "product-docs"
  ],
  "prHourlyLimit": 2,
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Activate automerge for eligible updates",
      "matchBaseBranches": [
        "main",
        "product-docs"
      ],
      "extends": [
        "github>rancher/renovate-config//automerge#release"
      ]
    }
  ]
}
